# Copy this file to .env and fill in real values. Never commit .env.
# The platform runs fully offline with NONE of these set — they only switch
# stubbed services over to their live equivalents.

# --- LLM provider (used by the agent layer + future live AI agents) ---
LLM_PROVIDER=openrouter            # one of: openrouter | anthropic | ollama | mock
LLM_API_KEY=                       # API key for the chosen provider
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- MCP server ---
MCP_PROJECT_ROOT=.                 # directory the MCP server is allowed to read

# --- BLAST API (apps/api) ---
PORT=5000
AUTH_SECRET=                       # long random string for signing session tokens
DATABASE_URL=                      # swap the in-memory store for Postgres/Supabase
STRIPE_SECRET_KEY=                 # set + `npm i stripe` to enable live payments
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:5000

# --- Mobile app (apps/mobile) ---
# Leave unset to use the offline mock. Set to point the app at the live API.
EXPO_PUBLIC_API_URL=

# --- Live AI-agent integrations (optional; agents are deterministic stubs until set) ---
# ANTHROPIC_API_KEY=               # real LLM behind the SEO/CRM/marketing agents
# SUNO_API_KEY=                    # real music generation (or REPLICATE_API_TOKEN)
# REPLICATE_API_TOKEN=
